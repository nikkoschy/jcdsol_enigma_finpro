    <worksheet name='Age Group Conv Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='8'>Conversion Rate Based on Age Group</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (bank_campaign_data)' name='federated.0s56u8u0qd4ule19yvg0l1j14z74' />
          </datasources>
          <datasource-dependencies datasource='federated.0s56u8u0qd4ule19yvg0l1j14z74'>
            <column caption='Deposit No' datatype='integer' name='[Calculation_872642849426972676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[y]=&apos;no&apos; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Conversion Rate in %' datatype='real' name='[Calculation_933934025623224321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [y] = &apos;yes&apos; THEN 1 ELSE 0 END) / COUNT([y])*100' />
            </column>
            <column caption='Age Group' datatype='string' name='[age_group]' role='dimension' type='nominal' />
            <column-instance column='[age_group]' derivation='None' name='[none:age_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_872642849426972676]' derivation='Sum' name='[sum:Calculation_872642849426972676:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_933934025623224321]' derivation='User' name='[usr:Calculation_933934025623224321:qk]' pivot='key' type='quantitative' />
            <column caption='Deposit' datatype='string' datatype-customized='true' name='[y]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0s56u8u0qd4ule19yvg0l1j14z74].[none:age_group:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:age_group:nk]' />
              <groupfilter function='member' level='[none:age_group:nk]' member='&quot;Under 18&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0s56u8u0qd4ule19yvg0l1j14z74].[none:age_group:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
