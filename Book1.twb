      <aliases enabled='yes' />
      <column caption='Conversion Rate' datatype='real' default-format='p0%' name='[Calculation_1201968572247179264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_872642849423654915]/([Calculation_872642849423654915]+[Calculation_872642849426972676])' />
      </column>
      <column caption='New Month' datatype='datetime' name='[Calculation_1201968572259016706]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL([month]) THEN DATEPARSE(&apos;dd/MM/yyyy HH.mm.ss&apos;, &quot;01/09/1900 00.00.00&quot;) ELSE [month] END' />
      </column>
      <column caption='Number of People Contacted' datatype='integer' name='[Calculation_872642849420546050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([y])' />
      </column>
      <column caption='Deposit Yes' datatype='integer' name='[Calculation_872642849423654915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF[y] = &apos;yes&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Deposit No' datatype='integer' name='[Calculation_872642849426972676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF[y]=&apos;no&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Count Deposit' datatype='integer' name='[Calculation_933934025612640256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([y])' />
      </column>
      <column caption='Conversion Rate in %' datatype='real' name='[Calculation_933934025623224321]' role='measure' type='quantitative'>
